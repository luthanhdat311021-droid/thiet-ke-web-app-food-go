# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (webhook thanh toán). Tuyệt đối không để lộ ra trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=

# Tài khoản nhận tiền cho mã VietQR
# BANK_ID: mã ngân hàng theo https://api.vietqr.io/v2/banks (cột "code" hoặc "bin"), ví dụ: MB, VCB, TCB, ACB, 970422
NEXT_PUBLIC_VIETQR_BANK_ID=MB
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=

# Khóa bí mật cho webhook SePay (tự đặt chuỗi ngẫu nhiên, nhập giống hệt trong SePay)
SEPAY_WEBHOOK_KEY=
